<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MVVM.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MVVM"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:docking="using:Syncfusion.UI.Xaml.Docking"
    xmlns:viewModel="using:MVVM.ViewModel"
    mc:Ignorable="d">

    <!--
        This is the main content area of your application.
        Add your UI elements here — for example, controls, layouts, and data-bound views.
        Use 'dotnet new winui-page' to create additional pages and navigate to them via
        the Frame in MainWindow (RootFrame).
    -->
    <Grid x:Name="grid">
        <Grid.DataContext>
            <viewModel:DockingViewModel/>
        </Grid.DataContext>
        <docking:SfDockingManager x:Name="dockingManager"
                              ItemsSource="{Binding Panes}"/>
    </Grid>
</Page>
